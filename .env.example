# Django Security & Core Settings
SECRET_KEY=django-insecure-change-me-for-production-key-here-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Default: SQLite, for PostgreSQL use: postgres://user:password@localhost:5432/dbname)
DATABASE_URL=sqlite:///db.sqlite3

# Email Backend Configuration (Leave empty for console output during development)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Store <no-reply@example.com>
ADMIN_EMAIL=admin@example.com
